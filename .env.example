# Variables comunes. Dentro de Docker Compose los servicios usan kafka:29092 y postgres:5432
# (ya están definidas en docker-compose.yml). Estos valores son para correr UN servicio
# directamente en tu máquina contra la infraestructura levantada con Compose:
#   docker compose up -d kafka kafka-init postgres mailhog
#   cp .env.example .env && set -a && . ./.env && set +a && pnpm --filter @poc/billing-service start
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=activation-poc
KAFKA_GROUP_ID=changeme
# Postgres publicado en 15432 (ver docker-compose.yml). Una base por servicio:
# activation_db | billing_db | provisioning_db | notification_db | crm_db | loyalty_db
DATABASE_URL=postgres://poc:poc@localhost:15432/activation_db
SMTP_HOST=localhost
SMTP_PORT=1025
# earliest (default): un group nuevo lee desde el inicio del log. latest: solo mensajes nuevos.
KAFKA_AUTO_OFFSET_RESET=earliest
# Latencias simuladas (ms)
BILLING_DELAY_MIN_MS=500
BILLING_DELAY_MAX_MS=1500
PROVISIONING_DELAY_MIN_MS=1000
PROVISIONING_DELAY_MAX_MS=3000
