# Imagen única para los servicios NestJS del monorepo.
#   docker build -f docker/Dockerfile.service --build-arg APP=billing-service .
# Instala y compila solo lo que necesita ese servicio (@poc/<APP> y sus libs de workspace).
FROM node:22-alpine
ARG APP
ENV APP=${APP} NODE_ENV=production KAFKAJS_NO_PARTITIONER_WARNING=1
RUN npm install -g pnpm@9.12.0
WORKDIR /repo

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY libs ./libs
COPY apps ./apps
# NODE_ENV=production haría que pnpm omita las devDependencies (typescript): se instalan igual para compilar.
RUN NODE_ENV=development pnpm install --frozen-lockfile --filter "@poc/${APP}..." \
 && pnpm --filter "@poc/${APP}..." build

CMD ["sh", "-c", "exec node apps/${APP}/dist/main.js"]
