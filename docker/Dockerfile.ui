# demo-ui: compila con Vite y sirve los estáticos con nginx.
# VITE_* se "hornean" en el build porque el navegador (no el contenedor) llama a las URLs.
FROM node:22-alpine AS build
ARG VITE_API_URL=http://localhost:3000
ARG VITE_KAFKA_UI_URL=http://localhost:8080
ARG VITE_MAILHOG_URL=http://localhost:8025
ENV VITE_API_URL=${VITE_API_URL} VITE_KAFKA_UI_URL=${VITE_KAFKA_UI_URL} VITE_MAILHOG_URL=${VITE_MAILHOG_URL}
RUN npm install -g pnpm@9.12.0
WORKDIR /repo
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY libs ./libs
COPY apps ./apps
RUN pnpm install --frozen-lockfile --filter "@poc/demo-ui..." && pnpm --filter "@poc/demo-ui..." build

FROM nginx:1.27-alpine
COPY --from=build /repo/apps/demo-ui/dist /usr/share/nginx/html
EXPOSE 80
